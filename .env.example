# Application
APP_NAME="Real-Time Cloud Event RSVP Tracker"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000
FRONTEND_URL="http://localhost:5173"

# Database (Local SQLite)
DATABASE_URL="sqlite+aiosqlite:///./event_tracker.db"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# Firebase / Google Cloud (Optional - for cloud deployment)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""
